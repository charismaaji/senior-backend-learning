{
	"name": "senior-backend-learning",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"build": "tsc",
		"start": "bun dist/index.js",
		"db:migrate": "dbmate --wait --no-dump-schema up",
		"db:rollback": "dbmate --no-dump-schema rollback",
		"db:status": "dbmate --no-dump-schema status"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/express": "^5.0.6",
		"@types/pg": "^8.20.0",
		"dbmate": "^2.34.1",
		"pino-pretty": "^13.1.3",
		"typescript": "^5.7.0"
	},
	"dependencies": {
		"express": "^5.2.1",
		"pg": "^8.22.0",
		"pino": "^10.3.1",
		"pino-http": "^11.0.0",
		"zod": "^4.4.3"
	}
}
